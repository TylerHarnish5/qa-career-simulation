  "item": [
    {
      "name": "Orders Requires Authentication",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Unauthenticated orders request redirects to login\", function () {\r\n    pm.expect(pm.response.code).to.equal(302);\r\n    pm.expect(pm.response.headers.get(\"Location\")).to.equal(\"/login\");\r\n});"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://127.0.0.1:5000/orders",
          "protocol": "http",
          "host": [
            "127",
            "0",
            "0",
            "1"
          ],
          "port": "5000",
          "path": [
            "orders"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Valid login credentials logs in",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "username",
              "value": "alex.morgan"
            },
            {
              "key": "password",
              "value": "Welcome123!"
            }
          ]
        },
        "url": {
          "raw": "http://127.0.0.1:5000/login",
