              "pm.test(\"Valid cart addition redirects to cart\", function () {\r\n    pm.expect(pm.response.code).to.equal(302);\r\n    pm.expect(pm.response.headers.get(\"Location\")).to.equal(\"/cart\");\r\n});"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "request": {
        "method": "POST",
